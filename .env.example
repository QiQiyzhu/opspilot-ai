OPSPILOT_REDIS_URL=redis://127.0.0.1:6379/0
OPSPILOT_AUTH_TOKENS='{"demo-viewer":{"id":"viewer-local","name":"Demo observer","role":"viewer"},"demo-operator":{"id":"operator-local","name":"Demo operator","role":"operator"},"demo-approver":{"id":"approver-local","name":"Demo reviewer","role":"approver"},"demo-admin":{"id":"admin-local","name":"Demo administrator","role":"admin"}}'
OPSPILOT_MODEL_CACHE=./model-cache
OPSPILOT_PROVIDER=fake
OPSPILOT_PROVIDER_URL=https://api.deepseek.com
